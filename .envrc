# .envrc (direnv): export this repo's secrets from secrets.enc.yaml (sops + age).
# Needs sops and this machine's age identity (~/.config/sops/age/keys.txt, or
# ~/Library/Application Support/sops/age/keys.txt on macOS). Recipients live in
# .sops.yaml; on a machine that is not one, this logs and the shell still works.
# Same text in every repo; the source of truth is flanhub templates/envrc.
if [ -f secrets.enc.yaml ]; then
  if out=$(sops -d --output-type json secrets.enc.yaml 2>&1); then
    eval "$(printf '%s' "$out" | python3 -c 'import json,shlex,sys
for k, v in json.load(sys.stdin).items():
    print(f"export {k}={shlex.quote(str(v))}")')"
  else
    log_error "secrets.enc.yaml: ${out##*$'\n'}"
  fi
fi
